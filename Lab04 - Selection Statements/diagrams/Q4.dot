digraph flowchart {
  graph [rankdir=TB, bgcolor="white", dpi=150, pad=0.15, nodesep=0.30, ranksep=0.28];
  node [shape=box, fontname="DejaVu Sans", fontsize=11, margin="0.12,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];
  start [shape=oval, label="Start"];
  end [shape=oval, label="End"];

  input [shape=parallelogram, label="Read day"];
  wd [shape=diamond, label="1 <= day <= 5?"];
  we [shape=diamond, label="day is 0 or 6?"];
  wdo [shape=parallelogram, label="Print Weekday"];
  weo [shape=parallelogram, label="Print Weekend"];
  other [shape=parallelogram, label="Print unknown DAY"];
  start -> input -> wd;
  wd -> wdo [label="Yes"];
  wd -> we [label="No"];
  we -> weo [label="Yes"];
  we -> other [label="No"];
  wdo -> end;
  weo -> end;
  other -> end;
}
