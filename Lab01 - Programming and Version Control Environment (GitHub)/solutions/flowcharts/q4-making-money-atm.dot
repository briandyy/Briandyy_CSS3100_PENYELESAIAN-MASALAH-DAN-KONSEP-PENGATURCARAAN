digraph flowchart {
    graph [rankdir=TB, bgcolor="white", pad=0.12];
    node [fontname="Helvetica", fontsize=12];
    edge [arrowsize=0.7];

    start [shape=ellipse, label="Start"];
    out [shape=parallelogram, label="Cetak banner Making Money Bank\nATM Service"];
    greeting [shape=parallelogram, label="Cetak baris kosong, lalu Welcome!"];
    end [shape=ellipse, label="End"];

    start -> out -> greeting -> end;
}
