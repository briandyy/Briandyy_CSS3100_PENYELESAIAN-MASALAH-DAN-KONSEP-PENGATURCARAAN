digraph flowchart {
    graph [rankdir=TB, bgcolor="white", pad=0.12];
    node [fontname="Helvetica", fontsize=12];
    edge [arrowsize=0.7];

    start [shape=ellipse, label="Start"];
    inp [shape=parallelogram, label="Baca first, second, third"];
    calc [shape=box, label="average = (first + second + third) / 3.0"];
    out [shape=parallelogram, label="Cetak ketiga bilangan dan average"];
    end [shape=ellipse, label="End"];

    start -> inp -> calc -> out -> end;
}
