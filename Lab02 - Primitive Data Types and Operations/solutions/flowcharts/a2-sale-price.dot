digraph flowchart {
    graph [rankdir=TB, bgcolor="white", pad=0.12];
    node [fontname="Helvetica", fontsize=12];
    edge [arrowsize=0.7];

    start [shape=ellipse, label="Start"];
    inp [shape=parallelogram, label="Baca price (RM) dan discount (%)"];
    calc [shape=box, label="sale = price * (100 - discount) / 100.0"];
    out [shape=parallelogram, label="Cetak harga awal, diskon, dan harga akhir"];
    end [shape=ellipse, label="End"];

    start -> inp -> calc -> out -> end;
}
